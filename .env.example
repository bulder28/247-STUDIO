# ==============================================================================
# 247 STUDIO - VARIABLES DE ENTORNO Y GUÍA DE TRASPASO A PRODUCCIÓN (.COM)
# ==============================================================================
# Instrucciones para el cliente final / administrador de sistemas:
# 1. Copiar este archivo como '.env' en la raíz del proyecto para despliegue local o CI/CD.
# 2. Configurar estas mismas claves en el panel de Netlify: "Site configuration" > "Environment variables".
# 3. En la consola de Firebase Authentication > "Settings" > "Authorized domains", agregar el dominio
#    definitivo (ej: "247studio.com", "app.247studio.com") además de "localhost".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL CLIENTE FIREBASE (Vite / Frontend PWA)
# Obtenidas en Firebase Console > Configuración del Proyecto > General > Tus apps > SDK Web
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment12345
VITE_FIREBASE_AUTH_DOMAIN=studio-247-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio-247-prod
VITE_FIREBASE_STORAGE_BUCKET=studio-247-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_USE_EMULATORS=false

# ------------------------------------------------------------------------------
# 2. SERVICIOS DE INTELIGENCIA ARTIFICIAL (Kokoro AI / Google Gemini)
# ------------------------------------------------------------------------------
# Clave privada para funciones serverless (Netlify Functions - netlify/functions/kokoro-ai.mjs).
# CRÍTICO: Configurar en las variables de entorno de Netlify (NO exponerla en el bundle del cliente).
# Obtener clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourPrivateServerlessGeminiApiKeyHere

# Clave opcional para desarrollo local sin servidor de funciones Netlify (vite dev puro)
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. NOTAS DE TRASPASO (HANDOVER .COM)
# ------------------------------------------------------------------------------
# - Dominio de producción: https://247studio.com o subdominio asignado.
# - DNS de Netlify: Apuntar los registros A / CNAME hacia los servidores de Netlify.
# - Certificado SSL: Generado automáticamente por Netlify vía Let's Encrypt una vez propagado el DNS.
# - Firebase Auth: Es mandatorio añadir el dominio personalizado a la lista de dominios autorizados
#   para permitir el inicio de sesión con Google OAuth sin errores auth/unauthorized-domain.
