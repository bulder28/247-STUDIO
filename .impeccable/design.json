  "narrative": {
    "northStar": "Tatami de noche",
    "overview": "El panel es una herramienta de recepción usada de pie, con una mano y a menudo en una tablet: contraste alto, objetivos táctiles generosos y una sola señal clara de acción. Un carril azul marino profundo ancla la navegación; sobre un lienzo arena cálido, las superficies blancas alojan el trabajo y los paneles azul marino alojan las cifras. El rojo es la única voz de acento.\n\nLa densidad es media y calmada: pocas cosas por pantalla, bien separadas, con jerarquía dada por el tamaño de las cifras (Oswald) y no por la decoración.",
    "keyCharacteristics": [
      "Carril azul marino + acento rojo único + lienzo arena + superficies blancas.",
      "Cifras grandes en Oswald con numerales tabulares.",
      "Objetivos táctiles de al menos 44 px.",
      "Plano: una sola elevación por superficie (borde o sombra, no ambos).",
      "Iconos lucide, sin emojis; sin degradados decorativos."
    ],
    "rules": [
      {
        "name": "La Regla de la Voz Única",
        "body": "El rojo es la única voz de acento: acción principal y elemento activo. No se usa como decoración ni como segundo color de marca.",
        "section": "colors"
      },
      {
        "name": "La Regla del Estado",
        "body": "Esmeralda, ámbar, azul y rosa significan solo estado (ok, pendiente, información, error); nunca adornan.",
        "section": "colors"
      },
      {
        "name": "La Regla de la Cifra Tabular",
        "body": "Todo importe, contador o cifra comparable usa tabular-nums para que las columnas no bailen.",
        "section": "typography"
      },
      {
        "name": "La Regla de los 12 px",
        "body": "Ninguna etiqueta de interfaz baja de 12 px.",
        "section": "typography"
      },
      {
        "name": "La Regla de una Sola Elevación",
        "body": "Una superficie usa borde o sombra, nunca ambos. La sombra solo aparece en diálogos y como respuesta a estado.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar el rojo solo para la acción principal y el elemento activo.",
      "Do mantener objetivos táctiles de al menos 44 px y foco visible en todo control.",
      "Do poner las cifras clave en Oswald con tabular-nums sobre panel azul marino.",
      "Do usar iconos de lucide con aria-hidden cuando acompañen texto.",
      "Do componer páginas con PageHeader, KpiCard y SectionCard."
    ],
    "donts": [
      "Don't usar emojis como iconos.",
      "Don't usar degradados decorativos.",
      "Don't combinar borde y sombra en una misma superficie.",
      "Don't usar etiquetas por debajo de 12 px.",
      "Don't usar color de estado como decoración."
    ]
  }
}