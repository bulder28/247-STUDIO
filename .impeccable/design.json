      "html": "<section class=\"ds-kpi-panel\"><div class=\"ds-kpi\"><span class=\"ds-kpi-label\">Cobrado</span><span class=\"ds-kpi-value ds-kpi-featured\">1.240 €</span><span class=\"ds-kpi-hint\">IVA incluido</span></div><button class=\"ds-kpi ds-kpi-btn\" type=\"button\"><span class=\"ds-kpi-label\">Por aprobar</span><span class=\"ds-kpi-value ds-kpi-warn\">3</span><span class=\"ds-kpi-hint\">Toca para revisarlos</span></button></section>",
      "css": ".ds-kpi-panel{font-family: Inter, system-ui, sans-serif;display:flex;gap:4px;padding:8px;border-radius:16px;background:#1A1D2E;color:#fff}.ds-kpi{display:block;min-width:140px;padding:14px 16px;border:0;border-radius:12px;background:transparent;color:inherit;text-align:left;font-family:inherit}.ds-kpi-label{display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.7)}.ds-kpi-value{display:block;margin-top:6px;font-family:Oswald,system-ui,sans-serif;font-size:36px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;color:#fff}.ds-kpi-featured{font-size:48px}.ds-kpi-warn{color:#FCD34D}.ds-kpi-hint{display:block;margin-top:8px;font-size:12px;font-weight:500;color:rgba(255,255,255,0.65)}.ds-kpi-btn{min-height:44px;cursor:pointer;transition:background-color .15s}.ds-kpi-btn:hover{background:rgba(255,255,255,0.1)}.ds-kpi-btn:focus-visible{outline:2px solid rgba(255,255,255,0.7)}"
    },
