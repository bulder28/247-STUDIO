      "kind": "card",
      "refersTo": "section-card",
      "description": "Superficie blanca con borde azul marino tenue y cabecera opcional; sin sombra.",
      "html": "<section class=\"ds-section\"><div class=\"ds-section-head\"><div><h2 class=\"ds-section-title\">Pagos del mes</h2><p class=\"ds-section-desc\">12 de 48 han pagado</p></div></div><div class=\"ds-section-body\">Contenido del bloque de trabajo.</div></section>",
      "css": ".ds-section{font-family: Inter, system-ui, sans-serif;width:340px;overflow:hidden;border:1px solid rgba(26,29,46,0.1);border-radius:16px;background:#fff;color:#1A1D2E}.ds-section-head{padding:16px 20px;border-bottom:1px solid rgba(26,29,46,0.1)}.ds-section-title{margin:0;font-size:18px;font-weight:700;line-height:1.25}.ds-section-desc{margin:2px 0 0;font-size:14px;color:#475569}.ds-section-body{padding:20px;font-size:14px}"
    },
